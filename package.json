{
  "name": "claycode",
  "version": "1.0.0",
  "description": "Build and modify real apps locally using natural language.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "start:dev": "NODE_ENV=development electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^29.4.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "ai.coana.claycode",
    "productName": "ClayCode",
    "copyright": "COANA Labs · San Juan, Puerto Rico",
    "directories": {
      "output": "dist",
      "buildResources": "build-assets"
    },
    "files": [
      "electron/**/*",
      "clay_server.py",
      "model_router.py",
      "agent_backend.py",
      "memory_dreaming.py",
      "requirements.txt",
      "index.html",
      "theme.css",
      "agents/**/*",
      "data/**/*"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": ".",
        "filter": [
          "*.py",
          "requirements.txt",
          "agents/**",
          "data/**"
        ]
      }
    ],
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "category": "public.app-category.developer-tools",
      "icon": "build-assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build-assets/icon.ico"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Development"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}

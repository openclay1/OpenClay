# OpenClay — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env — it contains secrets.

# Agent backend: "clawcode" (Ollama tool-use) or "claudecode" (Ollama run)
AGENT_BACKEND=clawcode

# Twitter / X (via Tweepy OAuth1)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Instagram (via Facebook Graph API)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Optional: cloud vision fallbacks (only used if Ollama llava is unavailable)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
